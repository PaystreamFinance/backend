# === Server ===
PORT=9090
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# === Database ===
DATABASE_URL=postgres://user:password@localhost:5432/paystream

# === Solana ===
SOLANA_NETWORK=MAINNET
SOLANA_RPC_URL=https://your-helius-rpc.com

# === Privy (embedded wallets) ===
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTH_PKEY=wallet-auth:...

# === Service Auth (shared secret between api <-> core-worker) ===
INTERNAL_SERVICE_KEY=

# === Jupiter ===
JUPITER_API_KEY=

# === Phoenix (perps) ===
PHOENIX_API_URL=https://perp-api.phoenix.trade

# === Helius ===
HELIUS_API_KEY=
HELIUS_SENDER_ENDPOINT=http://ewr-sender.helius-rpc.com/fast

# === Jito (bundle submission) ===
JITO_AUTH_KEYPAIR=

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=PaystreamBot

# === OpenTelemetry / SigNoz ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=api
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEBUG=false
SIGNOZ_INGESTION_KEY=

# === Ops Alerting (Telegram) ===
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=

# === BetterStack (phone call escalation for CRITICAL alerts) ===
BETTERSTACK_API_KEY=
BETTERSTACK_REQUESTER_EMAIL=
