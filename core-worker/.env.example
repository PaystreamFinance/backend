# === Database ===
DATABASE_URL=postgres://user:password@localhost:5432/paystream

# === Redis (BullMQ) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# === Solana ===
SOLANA_NETWORK=MAINNET
SOLANA_RPC_URL=https://your-helius-rpc.com

# === Service Auth (must match api's INTERNAL_SERVICE_KEY) ===
INTERNAL_SERVICE_KEY=
BACKEND_URL=http://localhost:9090

# === Jupiter ===
JUPITER_API_KEY=

# === Phoenix (perps) ===
PHOENIX_API_URL=https://perp-api.phoenix.trade

# === Worker Config ===
# "production" runs all services. Otherwise set ENABLED_SERVICES.
WORKER_ENV=local
ENABLED_SERVICES=arb,spot-perp,funding-rates,transfer-status

# === Intervals (ms) ===
ARB_PRODUCER_INTERVAL_MS=5000
SPOT_PERP_PRODUCER_INTERVAL_MS=5000
FUNDING_RATES_INTERVAL_MS=3600000
TRANSFER_STATUS_INTERVAL_MS=10000

# === OpenTelemetry / SigNoz ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=core-worker
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEBUG=false
SIGNOZ_INGESTION_KEY=

# === Ops Alerting (Telegram) ===
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=

# === BetterStack (phone call escalation for CRITICAL alerts) ===
BETTERSTACK_API_KEY=
BETTERSTACK_REQUESTER_EMAIL=
